<Window x:Class="PaymentApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PaymentApp.UI.ViewModels"
        Title="Платёжный модуль — Контракты в интерфейсе" Height="620" Width="920"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка со списком операций по методичке -->
            <ColumnDefinition Width="260"/>
            <!-- Правая колонка с карточкой выбранной операции -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="#F4F4F6" BorderBrush="#D1D1D6" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="Список операций" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Operations}" 
                         SelectedItem="{Binding SelectedOperation}" 
                         DisplayMemberPath="Title"/>
            </DockPanel>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка карточки -->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <Button DockPanel.Dock="Right" Content="Показать контракт" Padding="10,5" Click="ShowContractButton_Click"/>
                <TextBlock Text="{Binding SelectedOperation.Title, FallbackValue='Выберите операцию из списка слева'}" 
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Место под карточку с полями ввода операции -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15">
                <ContentControl Content="{Binding SelectedOperation}"/>
            </Border>

            <!-- НИЖНЯЯ ПАНЕЛЬ: Индикаторы PRE и POST строго по методичке -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="Состояние контрактов:" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- Индикатор PRE (зеленый / красный) -->
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E53935"/>
                                    <!-- Красный -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                            <Setter Property="Fill" Value="#43A047"/>
                                            <!-- Зеленый -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Предусловие: НЕ выполнено"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                            <Setter Property="Text" Value="Предусловие: выполнено"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Индикатор POST (зеленый / красный / серый) -->
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#BDBDBD"/>
                                    <!-- Серый, пока не нажали кнопку -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                            <Setter Property="Fill" Value="#43A047"/>
                                            <!-- Зеленый -->
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                            <Setter Property="Fill" Value="#E53935"/>
                                            <!-- Красный -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Постусловие: операция ещё не выполнялась"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                            <Setter Property="Text" Value="Постусловие: выполнено"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                            <Setter Property="Text" Value="Постусловие: НЕ выполнено"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Статус / текст ошибки -->
                    <TextBlock Text="{Binding SelectedOperation.StatusMessage}" 
                               Foreground="#555" Margin="22,4,0,0" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>