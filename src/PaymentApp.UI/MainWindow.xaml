<ui:FluentWindow x:Class="PaymentApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PaymentApp.UI.ViewModels"
        Title="Платёжный модуль" 
        Height="740" Width="1060"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <!-- Контекст данных представления -->
    <ui:FluentWindow.DataContext>
        <vm:MainViewModel/>
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Область системного заголовка окна -->
            <RowDefinition Height="Auto"/>
            <!-- Основная рабочая область -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна с системными кнопками -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Платёжный модуль — Контракты в интерфейсе" 
                     Icon="{ui:SymbolIcon Payment24}" />

        <!-- Основная сетка интерфейса -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <!-- Левая панель: меню выбора операций -->
                <ColumnDefinition Width="290"/>
                <!-- Правая панель: рабочая область операции -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: список операций -->
            <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок меню -->
                    <TextBlock Grid.Row="0" Text="Операции" FontSize="20" FontWeight="Bold" Margin="6,4,0,16"/>

                    <!-- Список операций -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Operations}" 
                             SelectedItem="{Binding SelectedOperation}" 
                             VerticalAlignment="Top"
                             BorderThickness="0" 
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <!-- Правая панель -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Заголовок и вызов контракта -->
                    <RowDefinition Height="Auto"/>
                    <!-- Форма параметров операции -->
                    <RowDefinition Height="*"/>
                    <!-- Панель диагностики контрактов -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок текущей операции и кнопка просмотра контракта -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" 
                               Content="Показать контракт" 
                               Icon="{ui:SymbolIcon DocumentText24}"
                               Click="ShowContractButton_Click"/>
                    <TextBlock Text="{Binding SelectedOperation.Title, FallbackValue='Выберите операцию'}" 
                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Контейнер формы выбранной операции -->
                <ui:Card Grid.Row="1" VerticalAlignment="Stretch" Padding="16">
                    <ContentControl Content="{Binding SelectedOperation}"/>
                </ui:Card>

                <!-- Индикаторы выполнения предусловий и постусловий -->
                <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Диагностика контрактов:" 
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <WrapPanel Orientation="Horizontal">
                            <!-- Индикатор предусловия (Pre) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <ui:InfoBadge Margin="0,0,8,0">
                                    <ui:InfoBadge.Style>
                                        <Style TargetType="ui:InfoBadge">
                                            <Setter Property="Severity" Value="Critical"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                                    <Setter Property="Severity" Value="Success"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:InfoBadge.Style>
                                </ui:InfoBadge>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Предусловие: НЕ выполнено"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                                    <Setter Property="Text" Value="Предусловие: выполнено"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Индикатор постусловия (Post) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <ui:InfoBadge Margin="0,0,8,0">
                                    <ui:InfoBadge.Style>
                                        <Style TargetType="ui:InfoBadge">
                                            <Setter Property="Severity" Value="Informational"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                                    <Setter Property="Severity" Value="Success"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                                    <Setter Property="Severity" Value="Critical"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:InfoBadge.Style>
                                </ui:InfoBadge>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Постусловие: операция ещё не выполнялась"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                                    <Setter Property="Text" Value="Постусловие: выполнено"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                                    <Setter Property="Text" Value="Постусловие: НЕ выполнено"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Текстовое описание статуса -->
                        <TextBlock Text="{Binding SelectedOperation.StatusMessage}" 
                                   FontSize="12" Margin="0,6,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>