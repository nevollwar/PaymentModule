<ui:FluentWindow x:Class="PaymentApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Платёжный модуль"
        Icon="PaymentModule.ico"
        Height="820" Width="1200"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- 0: Системная шапка с кнопками управления -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Вся рабочая область -->
            <RowDefinition Height="*"/>
            <!-- 2: Нижний статус-бар -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Системные кнопки окна (свернуть / развернуть / закрыть) -->
        <ui:TitleBar Grid.Row="0"
                     Title="Платёжный модуль"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <!-- Основная сетка: Левая колонка (меню) и Правая (контент) -->
        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Меню операций -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="ОПЕРАЦИИ МОДУЛЯ" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="8,6,0,12"/>

                    <!-- Список операций -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Operations}" 
                             SelectedItem="{Binding SelectedOperation}"
                             BorderThickness="0" 
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Контракт активен" FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Блок справки внизу левой панели -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="8" 
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Контроль контрактов" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Pre проверяется до запуска (Guard.Requires). Post проверяется после (Debug.Assert)." 
                                       FontSize="11" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Правая область: Шапка + Контракт + Экран операции -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 0: Заголовок экрана и кнопка контракта -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Полоса проверки контракта (Pre / Post) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Рабочая область операции -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок операции и кнопка справа -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedOperation.Title}" 
                                   FontSize="22" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Заполните параметры для автоматической проверки контракта" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Спецификация контракта"
                               Icon="{ui:SymbolIcon DocumentBulletListMultiple24}"
                               Appearance="Secondary"
                               Click="ShowContractButton_Click"
                               Padding="16,8"/>
                </Grid>

                <!-- Единый монитор контракта -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Статус PRE -->
                        <Border Grid.Column="0" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFDE7E9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                            <Setter Property="Background" Value="#FFE6F4EA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PRE (Вход): " FontWeight="Bold" FontSize="12"/>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ОШИБКА"/>
                                            <Setter Property="Foreground" Value="#D93025"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPreValid}" Value="True">
                                                    <Setter Property="Text" Value="ВЫПОЛНЕНО"/>
                                                    <Setter Property="Foreground" Value="#188038"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Статус POST -->
                        <Border Grid.Column="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                            <Setter Property="Background" Value="#FFE6F4EA"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                            <Setter Property="Background" Value="#FFFDE7E9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="POST (Выход): " FontWeight="Bold" FontSize="12"/>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ОЖИДАНИЕ"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="True">
                                                    <Setter Property="Text" Value="СОБЛЮДЕНО"/>
                                                    <Setter Property="Foreground" Value="#188038"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOperation.IsPostValid}" Value="False">
                                                    <Setter Property="Text" Value="НАРУШЕНО"/>
                                                    <Setter Property="Foreground" Value="#D93025"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Текст подсказки/ошибки -->
                        <TextBlock Grid.Column="2" 
                                   VerticalAlignment="Center" 
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedOperation.StatusMessage}"
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Содержимое конкретной операции -->
                <ContentControl Grid.Row="2" Content="{Binding SelectedOperation}"/>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <Border Grid.Row="2" 
                Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="● Режим контрактного контроля: активен" 
                           FontSize="11" Foreground="#188038" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>