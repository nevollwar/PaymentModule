<UserControl x:Class="PaymentApp.UI.Views.DepositView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: форма ввода (42%) -->
            <ColumnDefinition Width="42*"/>
            <!-- Правая колонка: таблица счетов и информация (58%) -->
            <ColumnDefinition Width="58*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Форма пополнения -->
        <Border Grid.Column="0" 
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Параметры пополнения" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Выбор счёта получателя -->
                    <TextBlock Text="Счёт зачисления (с дневным лимитом)" FontWeight="Medium" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding LimitAccounts}" 
                              SelectedItem="{Binding SelectedAccount}" 
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,8"/>

                    <!-- Информационная плашка текущих лимитов счёта -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Действующие лимиты выбранного счёта:" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedAccount.LimitInfo, FallbackValue='— выберите счёт для отображения лимитов —'}" 
                                       FontSize="11" 
                                       FontFamily="Consolas"
                                       Foreground="#005FB8"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Сумма пополнения -->
                    <TextBlock Text="Сумма пополнения, ₽" FontWeight="Medium" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Например: 3000,00"
                                FontSize="13"
                                ClearButtonEnabled="True"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                    <!-- Кнопка пополнения -->
                    <ui:Button Content="Пополнить счёт"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowCircleUp24}"
                               Command="{Binding ExecuteCommand}"
                               HorizontalAlignment="Stretch"
                               Padding="0,11"/>
                </StackPanel>

                <!-- Чек / Результат пополнения -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Результат операции" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <TextBlock Text="{Binding LastResultText}" 
                                   FontFamily="Consolas" 
                                   FontSize="12" 
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая колонка: Счета с лимитами и справка -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Верхняя часть: таблица счетов -->
                <RowDefinition Height="60*"/>
                <!-- Нижняя часть: описание лимитов -->
                <RowDefinition Height="40*"/>
            </Grid.RowDefinitions>

            <!-- Таблица счетов с лимитами -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Счета с установленными лимитами" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding LimitAccounts}" 
                              BorderThickness="0" 
                              Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Счёт" Width="100" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Владелец" Width="120" DisplayMemberBinding="{Binding Owner}"/>
                                <GridViewColumn Header="Баланс" Width="110" DisplayMemberBinding="{Binding Balance, StringFormat={}{0:N2} ₽}"/>
                                <GridViewColumn Header="Разовый лимит" Width="120" DisplayMemberBinding="{Binding SingleDepositLimit, StringFormat={}{0:N2} ₽}"/>
                                <GridViewColumn Header="Остаток суточного" Width="130" DisplayMemberBinding="{Binding DailyLimitRemaining, StringFormat={}{0:N2} ₽}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Справка по контрактным ограничениям операции 2 -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Правила контрактного контроля пополнения" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"/>

                    <TextBlock Text="1. Разовый лимит (SingleDepositLimit) — максимальная сумма одного пополнения." 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,0,0,4"/>

                    <TextBlock Text="2. Суточный остаток (DailyLimitRemaining) — сумма, которую ещё разрешено внести сегодня. При каждом пополнении остаток уменьшается ровно на внесенную сумму." 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,0,0,4"/>

                    <TextBlock Text="3. При превышении любого из лимитов кнопка блокируется, а индикатор PRE сообщает причину отказа." 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>