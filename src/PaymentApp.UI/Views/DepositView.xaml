<UserControl x:Class="PaymentApp.UI.Views.DepositView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Параметры пополнения -->
            <GroupBox Header="Параметры пополнения" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Счёт получателя:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding LimitAccounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName"/>

                    <!-- Информация о лимитах выбранного счёта -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,6"
                               Text="{Binding SelectedAccount.LimitInfo, FallbackValue='— выберите счёт —'}"
                               Foreground="#555" FontStyle="Italic" FontSize="11"/>

                    <TextBlock Grid.Row="2" Text="Сумма пополнения, ₽:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="160" HorizontalAlignment="Left"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Row="3" Grid.Column="1" Content="Пополнить" Margin="0,8,0,0"
                            Padding="16,5" HorizontalAlignment="Left"
                            Command="{Binding ExecuteCommand}"/>
                </Grid>
            </GroupBox>

            <!-- Результат последнего пополнения -->
            <GroupBox Header="Результат последнего пополнения" Padding="8" Margin="0,0,0,10">
                <TextBlock Text="{Binding LastResultText}" FontFamily="Consolas" TextWrapping="Wrap"/>
            </GroupBox>

            <!-- Текущее состояние счётов с лимитами -->
            <GroupBox Header="Счета с лимитами" Padding="8">
                <ListView ItemsSource="{Binding LimitAccounts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Счёт"    Width="100" DisplayMemberBinding="{Binding Number}"/>
                            <GridViewColumn Header="Владелец" Width="140" DisplayMemberBinding="{Binding Owner}"/>
                            <GridViewColumn Header="Баланс, ₽" Width="110" DisplayMemberBinding="{Binding Balance, StringFormat=N2}"/>
                            <GridViewColumn Header="Разовый лимит, ₽" Width="130" DisplayMemberBinding="{Binding SingleDepositLimit, StringFormat=N2}"/>
                            <GridViewColumn Header="Дневной остаток, ₽" Width="140" DisplayMemberBinding="{Binding DailyLimitRemaining, StringFormat=N2}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
