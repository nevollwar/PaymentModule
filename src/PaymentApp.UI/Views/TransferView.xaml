<UserControl x:Class="PaymentApp.UI.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- Поля ввода для перевода -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Параметры перевода" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Выбор счета отправителя -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Счет списания:" VerticalAlignment="Center" FontWeight="Medium"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding FromAccount}"
                                  DisplayMemberPath="DisplayName"/>

                        <!-- Выбор счета получателя -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Счет зачисления:" VerticalAlignment="Center" FontWeight="Medium"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding ToAccount}"
                                  DisplayMemberPath="DisplayName"/>

                        <!-- Ввод суммы -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Сумма перевода, ₽:" VerticalAlignment="Center" FontWeight="Medium"/>
                        <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Width="200" HorizontalAlignment="Left"
                                    PlaceholderText="0,00"
                                    ClearButtonEnabled="True"
                                    Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Кнопка запуска перевода -->
                        <ui:Button Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                                   Content="Выполнить перевод"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowSwap24}"
                                   Command="{Binding ExecuteCommand}"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Таблица счетов и проверка инварианта -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Счета платежной системы" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <ListView ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Номер счета" Width="140" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Владелец" Width="180" DisplayMemberBinding="{Binding Owner}"/>
                                <GridViewColumn Header="Баланс" Width="150" DisplayMemberBinding="{Binding Balance, StringFormat={}{0:N2} ₽}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Плашка общего баланса системы -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="Общий баланс системы:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalBalanceText, Mode=OneWay}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Чек последней транзакции -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Результат операции" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="{Binding LastResultText}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- История операций -->
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Журнал операций" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding JournalLines}" MinHeight="50" MaxHeight="130" 
                             BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                             FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>