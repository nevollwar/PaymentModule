<UserControl x:Class="PaymentApp.UI.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: форма ввода (42%) -->
            <ColumnDefinition Width="42*"/>
            <!-- Правая колонка: счета и история (58%) -->
            <ColumnDefinition Width="58*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: Параметры перевода -->
        <Border Grid.Column="0" 
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Параметры операции" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Счёт списания -->
                    <TextBlock Text="Счёт списания (источник)" FontWeight="Medium" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Accounts}" 
                              SelectedItem="{Binding FromAccount}" 
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,12"/>

                    <!-- Счёт зачисления -->
                    <TextBlock Text="Счёт зачисления (получатель)" FontWeight="Medium" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Accounts}" 
                              SelectedItem="{Binding ToAccount}" 
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,12"/>

                    <!-- Сумма перевода -->
                    <TextBlock Text="Сумма перевода, ₽" FontWeight="Medium" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Например: 1500,00"
                                FontSize="13"
                                ClearButtonEnabled="True"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                    <!-- Кнопка действия -->
                    <ui:Button Content="Выполнить перевод"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowSwap24}"
                               Command="{Binding ExecuteCommand}"
                               HorizontalAlignment="Stretch"
                               Padding="0,11"/>
                </StackPanel>

                <!-- Чек / Результат перевода -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Результат операции" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <TextBlock Text="{Binding LastResultText}" 
                                   FontFamily="Consolas" 
                                   FontSize="12" 
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ КОЛОНКА: Счета и журнал -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Верхняя часть: список счетов -->
                <RowDefinition Height="55*"/>
                <!-- Нижняя часть: журнал -->
                <RowDefinition Height="45*"/>
            </Grid.RowDefinitions>

            <!-- Счета системы -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Счета платёжной системы" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding Accounts}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Номер счёта" Width="130" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Владелец" Width="150" DisplayMemberBinding="{Binding Owner}"/>
                                <GridViewColumn Header="Баланс" Width="130" DisplayMemberBinding="{Binding Balance, StringFormat={}{0:N2} ₽}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Плашка инварианта системы -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="Сумма балансов системы (инвариант):" 
                                       VerticalAlignment="Center" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalBalanceText, Mode=OneWay}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Журнал операций -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Журнал транзакций" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding JournalLines}" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             FontFamily="Consolas" 
                             FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        CornerRadius="4" 
                                        Padding="8,4" 
                                        Margin="0,2">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>