<Window x:Class="PaymentApp.UI.Views.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Спецификация контракта" 
        Height="700" Width="780"
        MinHeight="580" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- 0: Заголовок операции -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Содержимое спецификации со скроллом -->
            <RowDefinition Height="*"/>
            <!-- 2: Нижняя панель с кнопкой закрытия -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с иконкой и названием -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DocumentBulletListMultiple24" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock x:Name="OperationTitleText" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Формальная спецификация: предусловия, постусловия и граничные случаи" 
                               FontSize="11" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Тело спецификации -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>

                <!-- Блок 1: Предусловия (Pre) -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="ПРЕДУСЛОВИЯ (PRE)" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       Foreground="#005FB8"/>
                            <TextBlock Text="Проверяются до старта через Guard.Requires" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                CornerRadius="6" 
                                Padding="12">
                            <TextBlock x:Name="PreText" 
                                       TextWrapping="Wrap" 
                                       FontFamily="Consolas" 
                                       FontSize="12" 
                                       LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Блок 2: Постусловия (Post) -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="ПОСТУСЛОВИЯ (POST)" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       Foreground="#188038"/>
                            <TextBlock Text="Верифицируются после выполнения через Debug.Assert" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                CornerRadius="6" 
                                Padding="12">
                            <TextBlock x:Name="PostText" 
                                       TextWrapping="Wrap" 
                                       FontFamily="Consolas" 
                                       FontSize="12" 
                                       LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Блок 3: Эффекты и исключения -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ПОБОЧНЫЕ ЭФФЕКТЫ И ИСКЛЮЧЕНИЯ" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="EffectsText" 
                                   TextWrapping="Wrap" 
                                   FontSize="12" 
                                   LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Блок 4: Граничные примеры -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="ГРАНИЧНЫЕ ПРИМЕРЫ ДЛЯ ТЕСТИРОВАНИЯ" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Валидный вход (зеленая плашка) -->
                        <Border Background="#F4FAF6" 
                                BorderBrush="#34A853" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12" 
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Корректный вход (операция завершается успешно):" 
                                           FontWeight="SemiBold" 
                                           FontSize="11" 
                                           Foreground="#188038" 
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="ValidExampleText" 
                                           TextWrapping="Wrap" 
                                           FontSize="12" 
                                           Foreground="#1F1F1F" 
                                           LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Невалидный вход (красная плашка) -->
                        <Border Background="#FDF3F2" 
                                BorderBrush="#EA4335" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Ошибочный вход (отказ по предусловию):" 
                                           FontWeight="SemiBold" 
                                           FontSize="11" 
                                           Foreground="#C5221F" 
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="InvalidExampleText" 
                                           TextWrapping="Wrap" 
                                           FontSize="12" 
                                           Foreground="#1F1F1F" 
                                           LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Подвал окна с кнопкой закрытия -->
        <Border Grid.Row="2" 
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Спецификация сформирована на основе доменных контрактов" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                           VerticalAlignment="Center"/>
                <ui:Button DockPanel.Dock="Right" 
                           Content="Закрыть" 
                           Appearance="Primary"
                           Width="120"
                           Padding="0,7"
                           IsDefault="True" 
                           Click="CloseButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>