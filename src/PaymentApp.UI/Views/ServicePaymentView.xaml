<UserControl x:Class="PaymentApp.UI.Views.ServicePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Параметры оплаты -->
            <GroupBox Header="Параметры оплаты услуги" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Счёт списания:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName"/>

                    <TextBlock Grid.Row="1" Text="Услуга:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding Services}"
                              SelectedItem="{Binding SelectedService}"/>

                    <TextBlock Grid.Row="2" Text="Сумма платежа, ₽:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="160" HorizontalAlignment="Left"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Превью комиссии -->
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2,0,4"
                               FontStyle="Italic" FontSize="11" Foreground="#555">
                        <Run Text="Комиссия / итого: "/>
                        <Run Text="{Binding CommissionPreviewText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <Button Grid.Row="4" Grid.Column="1" Content="Оплатить" Margin="0,6,0,0"
                            Padding="16,5" HorizontalAlignment="Left"
                            Command="{Binding ExecuteCommand}"/>
                </Grid>
            </GroupBox>

            <!-- Результат последней оплаты -->
            <GroupBox Header="Результат последней оплаты" Padding="8" Margin="0,0,0,10">
                <TextBlock Text="{Binding LastResultText}" FontFamily="Consolas" TextWrapping="Wrap"/>
            </GroupBox>

            <!-- Текущее состояние счетов -->
            <GroupBox Header="Счета системы" Padding="8">
                <ListView ItemsSource="{Binding Accounts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Счёт"    Width="100" DisplayMemberBinding="{Binding Number}"/>
                            <GridViewColumn Header="Владелец" Width="140" DisplayMemberBinding="{Binding Owner}"/>
                            <GridViewColumn Header="Баланс, ₽" Width="120" DisplayMemberBinding="{Binding Balance, StringFormat=N2}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
