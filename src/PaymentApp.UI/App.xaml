<Application x:Class="PaymentApp.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PaymentApp.UI.ViewModels"
             xmlns:views="clr-namespace:PaymentApp.UI.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подключение темы (Light или Dark) и стили всех элементов WPF-UI -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Карточки операций: ContentControl в MainWindow подбирает шаблон по типу ViewModel -->
            <DataTemplate DataType="{x:Type vm:TransferOperationViewModel}">
                <views:TransferView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DepositOperationViewModel}">
                <views:DepositView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServicePaymentOperationViewModel}">
                <views:ServicePaymentView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>